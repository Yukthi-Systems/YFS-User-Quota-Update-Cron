# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is git-ignored - never commit real credentials.

# ---- Schedule ----
# How often the sync runs (Go duration: 30s, 5m, 1h, ...). Default: 5m
SYNC_INTERVAL=5m

# ---- Source: Files database (users + user_quotas) ---- [required]
FILES_PG_URL=postgresql://user:password@files-db-host:5432/files_db?sslmode=disable
FILES_PG_MAX_CONNS=2
FILES_PG_MIN_CONNS=1

# ---- Target: main database (file_users) ---- [required]
MAIN_PG_URL=postgresql://user:password@main-db-host:5432/main_db?sslmode=disable
MAIN_PG_MAX_CONNS=5
MAIN_PG_MIN_CONNS=1
PG_UPDATE_CHUNK_SIZE=200
PG_WORKERS=4

# ---- Logging ----
# debug | info | warn | error
LOG_LEVEL=info
LOG_SHOW_CONSOLE=true
# Leave empty to log only to the console (docker logs).
LOG_FILE=
LOG_MAX_SIZE_MB=250
LOG_MAX_BACKUPS=10
LOG_MAX_AGE_DAYS=20
LOG_COMPRESS=true
